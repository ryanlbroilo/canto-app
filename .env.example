# EVA Hub — credenciais do proxy (LIDAS SÓ NO SERVIDOR, nunca vão pro bundle).
# Copie para .env.local e preencha com os seus valores do dashboard evahub.com.br.

# Chave de API (dashboard → API Console → API Keys). NUNCA commitar.
EVA_HUB_KEY=evh_live_xxxxxxxxxxxxxxxx

# ID da persona criada no EVA Hub (dashboard → Assistants → sua persona "EVA Vocal Coach").
EVA_ASSISTANT_ID=asst_xxxxxxxx
