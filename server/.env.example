# Backend do Canto — copie para .env e ajuste. NÃO commitar o .env real.

NODE_ENV=development
PORT=3333

# Postgres (para rodar a API/worker FORA do Docker, apontando pro compose)
DATABASE_URL=postgresql://canto:canto@localhost:5432/canto?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT — troque por segredos fortes em produção (>= 16 chars cada)
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGIN=*

# URL pública do FRONT (entra nos links de e-mail de verificação/reset).
# Em produção: https://app.seudominio.com
APP_URL=http://localhost:5173

# E-mail (verificação de conta + reset de senha)
# EMAIL_PROVIDER=dev  → os links são LOGADOS no console (ótimo em desenvolvimento).
# EMAIL_PROVIDER=smtp → envia de verdade; preencha os SMTP_* abaixo.
EMAIL_PROVIDER=dev
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=apikey_ou_usuario
# SMTP_PASS=senha_ou_api_key
# SMTP_FROM="Canto <nao-responda@seudominio.com>"

# Usados só pelo docker-compose (postgres):
# POSTGRES_USER=canto
# POSTGRES_PASSWORD=canto
# POSTGRES_DB=canto
