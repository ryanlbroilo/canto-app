# Backend do Canto — copie para .env e ajuste. NÃO commitar o .env real.

NODE_ENV=development
PORT=3333

# Postgres (para rodar a API/worker FORA do Docker, apontando pro compose)
DATABASE_URL=postgresql://canto:canto@localhost:5432/canto?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT — troque por segredos fortes em produção (>= 16 chars cada)
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGIN=*

# Usados só pelo docker-compose (postgres):
# POSTGRES_USER=canto
# POSTGRES_PASSWORD=canto
# POSTGRES_DB=canto
