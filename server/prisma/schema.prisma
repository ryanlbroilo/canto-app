// Schema multi-tenant do Canto (isolamento row-level por tenantId).
// Todo dado de domínio carrega tenantId e é sempre filtrado por ele no serviço.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Naipe (voz) de um membro no ministério de louvor. Rótulos de louvor + SATB.
enum VoicePart {
  MELODIA
  VOZ2
  VOZ3
  SOPRANO
  CONTRALTO
  TENOR
  BAIXO
  UNASSIGNED
}

model Tenant {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  createdAt    DateTime       @default(now())
  users        User[]
  sessions     VocalSession[]
  invites      Invite[]
  subscription Subscription?
  ministryPlan MinistryPlan?
}

// Assinatura por TENANT (não por usuário): o tenant tem o plano e todos os
// membros herdam os entitlements. Individual = tenant solo com Pro; igreja =
// tenant com Igreja. Espelha o Stripe (fonte da verdade = webhook).
model Subscription {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // free | pro | igreja | professor
  status               String    @default("free") // free | trialing | active | past_due | canceled
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Convite para entrar num tenant (professor/igreja convida alunos/time).
// Pode ser link reutilizável (maxUses null) ou direcionado a um e-mail.
model Invite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token       String    @unique
  email       String? // convite direcionado (opcional)
  role        Role      @default(MEMBER)
  expiresAt   DateTime
  maxUses     Int? // null = ilimitado (link de time); 1 = uso único
  useCount    Int       @default(0)
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model User {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String?
  role         Role           @default(MEMBER)
  createdAt    DateTime       @default(now())
  refreshTokens RefreshToken[]
  sessions     VocalSession[]
  state        UserState?
  ministryMember MinistryMember?

  // e-mail é único DENTRO do tenant (mesmo e-mail pode existir em tenants diferentes)
  @@unique([tenantId, email])
  @@index([tenantId])
}

// Estado do usuário sincronizado (perfil, range/baseline, settings, conquistas,
// onboarding) — segue o usuário entre dispositivos. Um por usuário (1:1).
// Sessões e gamificação derivada continuam em VocalSession; aqui fica o resto.
model UserState {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String
  profileName    String?
  profileGoal    String?
  settings       Json? // { noiseGate, fadingFeedback, targetGuide }
  baseline       Json? // VocalBaseline atual
  rangeHistory   Json? // VocalBaseline[]
  achievements   Json? // [{ id, at }]
  seenOnboarding Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Sessão de treino sincronizada do cliente (o mesmo SessionRecord do front).
model VocalSession {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String? // id gerado no cliente (idempotência de sync)
  kind          String // 'practice' | 'exercise'
  exerciseId    String?
  label         String
  durationSec   Int
  notesHitPct   Float
  avgCentsDev   Float
  featureReport Json? // feature-JSON do DSP (a EVA só vê números, nunca áudio)
  dateISO       DateTime
  processedAt   DateTime? // preenchido pelo worker da fila
  xpEarned      Int? // calculado pelo worker
  createdAt     DateTime  @default(now())

  @@unique([tenantId, userId, clientId])
  @@index([tenantId, userId])
}

// Registro de execução de jobs da fila (observabilidade da fila operacional).
model JobRun {
  id        String   @id @default(cuid())
  tenantId  String?
  queue     String
  name      String
  status    String // 'completed' | 'failed'
  attempts  Int      @default(1)
  data      Json?
  result    Json?
  error     String?
  createdAt DateTime @default(now())

  @@index([queue, status])
}

// Plano de ensaio compartilhado do ministério (1 por tenant). O líder monta o
// aquecimento (ids de exercícios da biblioteca) + o set de harmonia (drills);
// todos os membros leem. Guardado em DUAS colunas Json — o front recebe uma
// lista plana de itens (o api.ts mescla/separa por tipo).
model MinistryPlan {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String   @default("Ensaio do ministério")
  notes       String?
  warmup      Json? // string[] de exerciseIds da biblioteca (aquecimento)
  harmonySet  Json? // [{ ref, label }] dos drills de harmonia (set de encaixe)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Naipe (voz) de cada membro no ministério (1 por usuário). Aditivo: usuários
// sem registro caem em UNASSIGNED.
model MinistryMember {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  voicePart VoicePart @default(UNASSIGNED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
}
