{
  "name": "canto-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Plataforma web de treino vocal com IA — DSP no navegador + coach EVA",
  "scripts": {
    "sync:ort": "node scripts/sync-ort.mjs",
    "predev": "npm run sync:ort",
    "prebuild": "npm run sync:ort && npm run test:eva",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test:eva": "node scripts/check-eva-voice.mjs",
    "test:align": "tsx scripts/test-align.ts",
    "test:karaoke": "tsx scripts/test-karaoke.ts",
    "test:latency": "tsx scripts/test-latency.ts",
    "test:swiftf0": "tsx scripts/test-swiftf0.ts",
    "import:song": "tsx scripts/import-song.ts",
    "gen:icons": "node scripts/gen-icons.mjs",
    "build:dsp": "cd dsp && wasm-pack build --target web --out-dir ../src/wasm --release",
    "test:dsp": "cd dsp && wasm-pack build --target nodejs --out-dir pkg-node --release && node test-wasm.cjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "test:attribution": "tsx scripts/test-attribution.ts",
    "test:capability": "tsx scripts/test-capability.ts",
    "test:verdict": "tsx scripts/test-verdict.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
