{
  "name": "canto-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Plataforma web de treino vocal com IA — DSP no navegador + coach EVA",
  "scripts": {
    "sync:ort": "node scripts/sync-ort.mjs",
    "predev": "npm run sync:ort",
    "prebuild": "npm run sync:ort",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:dsp": "cd dsp && wasm-pack build --target web --out-dir ../src/wasm --release",
    "test:dsp": "cd dsp && wasm-pack build --target nodejs --out-dir pkg-node --release && node test-wasm.cjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
